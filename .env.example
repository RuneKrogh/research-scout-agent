# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional PydanticAI model string, e.g. google:gemini-3.5-flash-lite (the default)
RESEARCH_SCOUT_MODEL=

# Optional free OpenAlex key (https://openalex.org/settings/api) for a higher daily limit
OPENALEX_API_KEY=
