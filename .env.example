# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional fallback provider
GROQ_API_KEY=

# Optional PydanticAI model string (provider:model). Comma-separate several for fallback.
# Leave empty for the default (Gemini Flash-Lite).
RESEARCH_SCOUT_MODEL=

# Optional but recommended: free OpenAlex key (https://openalex.org/settings/api).
# Without it, requests share a small daily budget per IP address.
OPENALEX_API_KEY=
