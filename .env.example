# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional fallback provider
GROQ_API_KEY=

# PydanticAI model string (provider:model). Leave empty to use the default in config.
RESEARCH_SCOUT_MODEL=

# Optional: your email for the OpenAlex "polite pool" (faster, more reliable)
OPENALEX_MAILTO=
